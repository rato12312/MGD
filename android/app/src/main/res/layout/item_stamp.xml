<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/stamp_cap_bg"
    android:padding="10dp"
    android:layout_margin="0dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/stampArt"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:scaleType="centerCrop"
        android:background="@drawable/stamp_cap_art" />

    <TextView
        android:id="@+id/stampPostmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="monospace"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.1em"
        android:textAllCaps="true"
        android:textColor="@color/kingdom_navy"
        android:background="@color/moon_gold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:layout_gravity="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stampTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/stampSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:textColor="@color/ink_secondary"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <ImageView
            android:id="@+id/stampMoon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_moon"
            android:contentDescription="@string/moons"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/stampMoons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/kingdom_navy"
            android:fontFamily="sans-serif-medium"
            android:fontFamily="@font/baloo2_bold"
            android:includeFontPadding="false" />
</LinearLayout>