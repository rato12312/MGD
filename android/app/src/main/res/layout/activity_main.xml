<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".MainActivity">

    <!-- Vulkan Surface View for rendering -->
    <com.mgd.odyssey.VulkanSurfaceView
        android:id="@+id/vulkan_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay UI -->
    <LinearLayout
        android:id="@+id/overlay_ui"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/fps_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: 0.0"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/frame_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frame: 0.00 ms"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/draw_calls_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Draw Calls: 0"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/vram_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VRAM: 0 MB"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_load_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_load_game" />

        <Button
            android:id="@+id/btn_pause_resume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_pause" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>