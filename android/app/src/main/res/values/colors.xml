<resources>
    <style name="Theme.MGD" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mgd_primary</item>
        <item name="colorPrimaryVariant">@color/mgd_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mgd_accent</item>
        <item name="colorSecondaryVariant">@color/mgd_accent_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/mgd_primary_dark</item>
        <item name="android:navigationBarColor">@color/mgd_primary_dark</item>
    </style>
    
    <color name="mgd_primary">#1E88E5</color>
    <color name="mgd_primary_dark">#1565C0</color>
    <color name="mgd_accent">#FF6D00</color>
    <color name="mgd_accent_dark">#E65100</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="surface">#121212</color>
    <color name="on_surface">#FFFFFF</color>
</resources>